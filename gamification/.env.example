DATABASE_DSN=
JWT_SECRET=

# Необязательные. Если имя не задано, процесс берёт значение справа.
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
DB_MAX_OPEN_CONNS=10
